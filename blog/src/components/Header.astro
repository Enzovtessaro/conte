---
import { SITE, CATEGORIES } from '../lib/site';
const nav = (['tributacao', 'planejamento-fiscal', 'contabilidade', 'prestacao-de-servico'] as const).map((s) => ({ href: `/category/${s}`, label: CATEGORIES[s].name }));
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="wrap header-inner">
    <a href="/" class="brand" aria-label="Blog da Conte, página inicial">
      <img src={SITE.logo} alt="Conte" width="120" height="32" />
      <span>Blog</span>
    </a>
    <nav aria-label="Categorias">
      <ul>
        {nav.map((n) => <li><a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a></li>)}
      </ul>
    </nav>
    <a class="btn btn-sm" href={`${SITE.mainSite}/?utm_source=blog&utm_medium=header`}>Conheça a Conte</a>
  </div>
</header>
