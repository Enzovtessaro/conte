---
import Base from '../layouts/Base.astro';
import PostCard from './PostCard.astro';
import Pagination from './Pagination.astro';
import { SITE, CATEGORIES } from '../lib/site';
import { itemList } from '../lib/listing';
import type { Post } from '../lib/posts';
interface Props { posts: Post[]; current: number; total: number }
const { posts, current, total } = Astro.props;
const first = current === 1;
const title = first ? `${SITE.name}: contabilidade e impostos para PJ de tecnologia` : `${SITE.name}, página ${current}`;
const pageUrl = (n: number) => (n === 1 ? `${SITE.url}/` : `${SITE.url}/pagina/${n}`);
const description = first ? SITE.description : `Artigos do Blog da Conte sobre contabilidade e impostos para PJ de tecnologia, página ${current} de ${total}.`;
---
<Base
  title={title}
  description={description}
  jsonLd={[{ '@type': 'CollectionPage', url: pageUrl(current), name: title, mainEntity: itemList(posts, title) }]}
  prev={current > 1 ? pageUrl(current - 1) : undefined}
  next={current < total ? pageUrl(current + 1) : undefined}
>
  {first ? (
    <section class="hero wrap">
      <h1>Contabilidade para quem trabalha como PJ na tecnologia</h1>
      <p>Impostos, nota fiscal, Simples Nacional, pró-labore e recebimento do exterior, explicados sem juridiquês por contadoras que atendem devs, designers e gente de produto todos os dias.</p>
      <ul class="chips" aria-label="Categorias">
        {Object.entries(CATEGORIES).map(([slug, c]) => <li><a href={`/category/${slug}`}>{c.name}</a></li>)}
      </ul>
    </section>
  ) : (
    <header class="wrap page-head"><h1>Todos os artigos, página {current}</h1></header>
  )}
  <section class="wrap" aria-label="Artigos">
    <div class="grid">{posts.map((p, i) => <PostCard post={p} eager={first && i < 2} priority={first && i === 0} />)}</div>
    <Pagination current={current} total={total} />
  </section>
</Base>
