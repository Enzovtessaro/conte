# Configurações da automação de abertura de empresa

# CPF para login no gov.br
CPF_LOGIN=000.000.000-00

# ============================================
# BROWSER NA NUVEM (opcional)
# ============================================

# Opção 1: Browserless.io
# Obtenha seu token em: https://browserless.io
BROWSERLESS_TOKEN=

# Opção 2: Endpoint WebSocket customizado
# Para qualquer serviço que suporte CDP (Chrome DevTools Protocol)
# Ex: wss://seu-servidor.com/chrome?token=xyz
BROWSER_WS_ENDPOINT=

# ============================================
# EXEMPLOS DE SERVIÇOS DE BROWSER NA NUVEM
# ============================================

# Browserless.io (recomendado)
# - Plano gratuito: 6 horas/mês
# - URL: wss://chrome.browserless.io?token=SEU_TOKEN
# BROWSERLESS_TOKEN=seu_token_aqui

# Chrome em Docker (self-hosted)
# docker run -p 3000:3000 browserless/chrome
# BROWSER_WS_ENDPOINT=ws://localhost:3000

# Bright Data (antigo Luminati)
# BROWSER_WS_ENDPOINT=wss://seu_endpoint.brightdata.com

# Steel.dev
# BROWSER_WS_ENDPOINT=wss://connect.steel.dev?apiKey=SEU_API_KEY
